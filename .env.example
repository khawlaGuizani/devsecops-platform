# Copy this file to .env and fill in real values before running
# `docker compose up`. Never commit the actual .env file.
#
# Local dev vs. production: docker-compose.yml alone is image-only (no
# `build:`) so it can be deployed as-is by deploy.yml. Running `docker
# compose up --build` in this directory also picks up
# docker-compose.override.yml (auto-merged by Compose), which adds back the
# `build:` sections pointing at ../backend and ../frontend — that override
# file is never shipped to the server.

# SQL Server SA password — also used as the backend's DB_PASSWORD (user is
# fixed to "sa" in backend/src/main/resources/application.properties).
# Must satisfy SQL Server's complexity policy (8+ chars, upper/lower/digit/symbol).
MSSQL_SA_PASSWORD=Ch4ngeMe!2026

# SQL Server edition. Express is free and sufficient for dev/demo workloads.
MSSQL_PID=Express

# SMTP credentials used by spring-boot-starter-mail (leave blank to disable
# outbound mail; the mail health indicator is already excluded from
# /actuator/health so this never affects container health).
MAIL_USERNAME=
MAIL_PASSWORD=

# RASP (Runtime Application Self-Protection) — see README-DEVSECOPS.md
RASP_ENABLED=true
RASP_MODE=block
RASP_DEMO_ENABLED=false

# Pin to specific images built by CI instead of building locally, e.g.:
# BACKEND_IMAGE=ghcr.io/khawlaguizani/backend:latest
# FRONTEND_IMAGE=ghcr.io/khawlaguizani/frontend:latest
BACKEND_IMAGE=transport-backend:local
FRONTEND_IMAGE=transport-frontend:local

# Host ports (change if 8080/8081 are already taken on your machine)
BACKEND_PORT=8080
FRONTEND_PORT=8081
